        if -condition -pre 
        then -cause

FeatureGroups:
    NUMBER= singular plural
    GENDER= masculine feminine neuter
    PAST= perfect pastPart
    PRESENT= 3PPresent simple continuous
    PERSON= 1stPerson 2ndPerson 3rdPerson
    MODE= advice obligation offer futureProbability ability permission
    TENSE_TIME= simple continuous perfect 3PPresent pastPart
    TENSE_COMPLETENESS= complete continuous
    TRANSITIVITY= Transitive Intransitive Ditransitive
    DETERMINATION= determined undetermined
    ANIMACY= animate inanimate

Predicates:
    IS              object->    object_count noun_class
    HAS_PROPERTY    object->    property
    TENSE           action->    time        completeness
    PREPOSITION     action->    preposition object->
    ACTION          action->    actor->     action_type     (object->)  (indirect_object->)
    CAN_DO          action_type actor->
    SPECIFIER       object->    person      number
    CONTAINS        container-> containee->
    ANAPHORIC       object->    anaphoric_object->
    OBJECT          object->    id
    NAME            object->    name
    TOPIC           object->
    CONJUNCTION     conjunction object_1->  object_2->
    CAUSATION       cause->     effect->
    EXISTS          object->
    ALL             object->

InferenceRules:
    Unify-All
        IF
            IS object:universal object_count:inf noun_class:universal_class
            IS object:particular object_count:particular_count noun_class:universal_class
            * all_connected:universal
        THEN
            IS object:particular object_count:particular_count noun_class:universal_class
            * all_connected:particular
        # horses are animals
        # a horse bit a man
        #? did an animal bite a man
        #> yes
    Inherit-Abilities
        IF
            IS object:hypernym_object object_count:inf noun_class:hypernym_class
            IS object:hyponym_object object_count:_ noun_class:hyponym_class
            CONTAINS container:hypernym_object containee:hyponym_object
            CAN_DO action_type:hypernym_action actor:hypernym_object
        THEN
            CAN_DO action_type:hypernym_action actor:hyponym_object
        # animals can run
        # horses are animals
        #? can horses run
        #> yes

Frames:
    NounPhrase "NP"
        #<TOPIC object:AnaphoricNounPhrase->ANAPHORIC.object>
        Determiner[Article] Noun[MainNoun,NUMBER] -NUMBER -determined <IS object:! object_count:"1" noun_class:Noun>
            # the dog
            # the dogs

        AnaphoricNounPhrase
            # the dog that got bit by a horse
        Noun[Name] -MainNoun -singular <NAME object:! name:Noun | IS object:! object_count:"1" noun_class:"unknown">

        Noun[Name] NounPhrase[singular,determined] <NAME object:NounPhrase->IS.object name:Noun>
            # steve the dog

        Noun[plural,MainNoun] -plural <IS object:! object_count:"inf" noun_class:Noun>
            # dogs
        Noun[singular,MainNoun] -singular -undetermined <IS object:! object_count:"1" noun_class:Noun>
            # dog

        Noun[Pronoun,singular,active] -singular -pronoun -active <IS object:! object_count:"1" noun_class:"person">
            # i
            # he
            # !him
        Noun[Pronoun,singular,subjective] -singular -pronoun -subjective <IS object:! object_count:"1" noun_class:"person" | SPECIFIER object:! person:"1P" number:"1">
            # him
            # me

        Determiner[Demonstrative,NUMBER] Noun[NUMBER] -NUMBER <IS object:! object_count:"1" noun_class:Noun>
            # this dog
            # those dogs
            # these dogs
            # that dog
            # !those dog
            # !this dogs

        Determiner[Quantifier,irregular] Noun[NUMBER] -NUMBER <IS object:! object_count:"1" noun_class:Noun>
            # any dogs
            # any dog

        Determiner[Quantifier] Noun[plural] -NUMBER <IS object:! object_count:"1" noun_class:Noun>
            # some dogs
            # most dogs
            # several dogs
            # !most dog

        Determiner[Quantifier,Corpuscular,determined] Noun[plural] -NUMBER <IS object:! object_count:"1" noun_class:Noun>
            # several dogs

        Determiner[Quantifier,!Corpuscular] Noun[MassNoun] -NUMBER <IS object:! object_count:"2" noun_class:Noun>
            # some water
            # some code
            # most water
            # !several water

        Determiner AdjectivePhrase[NUMBER] -NUMBER -determined
            # the ugly dog
            # the fat man
        NounPhrase[determined] PrepPhrase

        Adjective[PossessiveAdjective] NounPhrase[!pronoun,!determined] -determined
            # my cat
            # his cat
            # her cat

        Noun[plural] PrepPhrase <IS object:! object_count:"inf" noun_class:Noun>
            # dogs in the city
        NounPhrase Conjunction NounPhrase -plural
            # cats and dogs
            # cat and fish
        #<CONJUNCTION object_1:! object_2:NounPhrase#1->IS.object object_2:NounPhrase#2->IS.object>
        # this does not work yet. need to update binarization process, and also parser handing of binarized multiframes

        #Noun[Pronoun,possessive] NounPhrase[!determined,NUMBER] -determined -NUMBER
        # my cat 
        # !my the cat

        Determiner[determined] Noun[MassNoun] -determined -singular <IS object:! object_count:"mass" noun_class:Noun>
            # the water
            # that grease

        Determiner[Demonstrative] Noun[MassNoun]
            # that grass

        Adjective[MainAdjective] Noun[plural] -plural <IS object:! object_count:"inf" noun_class:Noun | HAS_PROPERTY object:! property:Adjective>
            # young dogs

        Noun[MainNoun,!plural] Noun[MainNoun,NUMBER] -NUMBER
            # pig dogs
            # pig dog
        Noun[MassNoun] Noun[MainNoun,NUMBER] -NUMBER
            # sea animals
            # land mammal

        Noun[Name] NounPhrase[singular,determined] -singular <NAME object:NounPhrase->IS.object name:Noun>
    AnaphoricNounPhrase "AnNP"
        NounPhrase[NUMBER] AnaphoricActionDescriptivePhrase[transitive] -NUMBER -actor -anaphoric <AnaphoricActionDescriptivePhrase->ACTION.actor=NounPhrase->IS.object | ANAPHORIC object:NounPhrase->IS.object anaphoric_object:!>
            # the dog that bit the person
        NounPhrase[NUMBER] AnaphoricActionDescriptivePhrase[Intransitive] -NUMBER -actor -anaphoric <AnaphoricActionDescriptivePhrase->ACTION.actor=NounPhrase->IS.object | ANAPHORIC object:NounPhrase->IS.object anaphoric_object:!>
            # the pig that flew
        NounPhrase AnaphoriObjectDescriptivePhrase -object -actor_unfilled <AnaphoriObjectDescriptivePhrase->ACTION.object=NounPhrase->IS.object | ANAPHORIC object:NounPhrase->IS.object anaphoric_object:!>
            # the person that got bit
        NounPhrase[NUMBER] VerbPhrase[NUMBER,transitive,object_unfilled] -NUMBER <VerbPhrase->ACTION.object=NounPhrase->IS.object | ANAPHORIC object:NounPhrase->IS.object anaphoric_object:!>
            # the man a dog bit
        NounPhrase[NUMBER] AnaphoricActorDescriptivePhrase[NUMBER] -NUMBER <AnaphoricActorDescriptivePhrase->ACTION.object=NounPhrase->IS.object | ANAPHORIC object:NounPhrase->IS.object anaphoric_object:!>
            # the man that a dog bit

        AnaphoricNounPhrase[actor_unfilled] ActorDescriptivePhrase -actor <AnaphoricNounPhrase->ACTION.actor=ActorDescriptivePhrase->IS.object>
            # the man that got bit by the dogs
        NounPhrase[NUMBER,determined] AnaphoricIndirectObjectObjectDescriptivePhrase <AnaphoricIndirectObjectObjectDescriptivePhrase->ACTION.actor=NounPhrase->IS.object>
            # the dog that gave the fish some food
    AnaphoricInquisitivePhrase "anIP"
        Verb[LinkingVerb,NUMBER] AnaphoricNounPhrase
            # <is the dog that bit the horse> ugly
    AnaphoricActionDescriptivePhrase "AnAtDP"
        Noun[RelativePronoun] VerbPhrase[transitive,actor_unfilled] -transitive -actor_unfilled -descriptive
            # the dog <that bit a person> is ugly
        Noun[RelativePronoun,ANIMACY] Verb[Intransitive] -ANIMACY -Intransitive -intransitive -actor_unfilled <ACTION action:! actor:!! action_type:Verb>
            # the runner <that fell> is clumsy
        #<ACTION action:! actor:"unknown" action_type:Verb>
    AnaphoricActorDescriptivePhrase "AnArDP"
        Noun[RelativePronoun] VerbPhrase[NUMBER,transitive,object_unfilled] -NUBER 
            # the man <that the dog bit>
    AnaphoricIndirectObjectObjectDescriptivePhrase "AnIOODP"
        AnaphoricIndirectObjectDescriptivePhrase NounPhrase[determined] <AnaphoricIndirectObjectDescriptivePhrase->ACTION.indirect_object=NounPhrase->IS.object>
            # the man <that gave the cat | some meat>
    AnaphoriObjectDescriptivePhrase "AnODP"
        Noun[RelativePronoun] SubjectDescriber -transitive -actor_unfilled -descriptive
            # the person <that got bit> is ugly
            # the person <that was bitten> is ugly
    AnaphoricIndirectObjectDescriptivePhrase "AnIODP"
        Noun[RelativePronoun] VerbPhrase[ditransitive,indirect_object_unfilled] -ditransitive -object_unfilled
            # the man <that | gave the cat> some meat
    ActorDescriptivePhrase "ActrDP"
        Preposition[Preposition,Actor] NounPhrase
            # the man that got bit <by the dog>

    SubjectActorDescriber "SuAD"
        SubjectDescriber ActorDescriptivePhrase <SubjectDescriber->ACTION.actor=ActorDescriptivePhrase->IS.object>
            # a man <got bit | by the dog>

    SubjectDescriber "SuD"
        Verb[IndicativeVerb,past] Verb[MainVerb,pastPart] -past <ACTION action:! actor:"unknown" action_type:Verb#2 object:"unknown">
            # was bitten
        Verb[IndicativeVerb,past] Verb[MainVerb,perfect] -past <ACTION action:! actor:"unknown" action_type:Verb#2 object:"unknown">
            # got bit
        # will be bit
        # will have been bit
    VerbPhrase "VP"
        Verb[MainVerb,Transitive] NounPhrase -transitive -actor_unfilled <ACTION action:! actor:"unknown" action_type:Verb object:NounPhrase->IS.object>
            # the horse that <bit a man> is ugly
        Verb[MainVerb,Ditransitive] NounPhrase -ditransitive -actor_unfilled -indirect_object_unfilled <ACTION action:! actor:"unknown" action_type:Verb object:NounPhrase->IS.object indirect_object:"unknown">
            # the horse that <gave a man> a gift
        Verb[TRANSITIVITY] Adverb -TRANSITIVITY <ACTION action:! actor:"unknown" action_type:Verb | HAS_PROPERTY object:! property:Adverb>
            # run quickly
        Adverb Verb
            # quickly run

        # VerbPhrase[Intransitive,NUMBER] PrepPhrase -NUMBER <PrepPhrase->PREPOSITION.object=VerbPhrase->ACTION.action>
        # ran into a river
        Verb[MainVerb,TRANSITIVITY,MainVerb] PrepPhrase -TRANSITIVITY -simple <ACTION action:! actor:"unknown" action_type:Verb>
            # run into the field
        # TODO - make the preposition attach to the main noun of the actor
        Verb[Transitive,!perfect,MainVerb] Noun[MassNoun] -singular -actor_unfilled -transitive -simple <ACTION action:! actor:"unknown" action_type:Verb object:!!| IS object:!! object_count:"inf" noun_class:Noun>
            # i <eat grass>
            # you <eat grass>
            # they <eat grass>
            # he <eats grass>
        Verb[Transitive,MainVerb] Noun[MassNoun] -plural -transitive -actor_unfilled -simple <ACTION action:! actor:"unknown" action_type:Verb object:!! | IS object:!! object_count:"inf" noun_class:Noun>
            # we <eat grass>
            # they <eat grass>
            # them <eating grass>

        # intransitive
        NounPhrase[plural] Verb[MainVerb,!3PPresent,!Transitive] -plural -intransitive <ACTION action:! actor:NounPhrase->IS.object action_type:Verb>
            # the dogs run
            # !the dogs runs
        NounPhrase[singular] Verb[MainVerb,!simple,!Transitive] -singular -intransitive <ACTION action:! actor:NounPhrase->IS.object action_type:Verb>
            # a dog runs
            # !a dog run

        Verb[continuous,Intransitive] -continuous <ACTION action:! actor:"unknown" action_type:Verb>
            # running

        Verb[ActionTransitive] -action_transitive <ACTION action:! actor:"unknown" action_type:Verb object:"unknown">

        # with fixed multiframe parsing, this can be simplified to
        # NounPhrase VerbPhrase[action_transitive] VerbPhrase
        NounPhrase[NUMBER] VerbPhrase[action_transitive] -action_transitive -action_unfilled <VerbPhrase->ACTION.actor=NounPhrase->IS.object>
            # <i hate>

        # transitive
        NounPhrase[plural] Verb[MainVerb,!3PPresent,Transitive] -plural -transitive -object_unfilled <ACTION action:! actor:NounPhrase->IS.object action_type:Verb object:"unknown">
            # the dogs bit
            # !the dogs bites
        NounPhrase[singular] Verb[MainVerb,!simple,Transitive] -singular -transitive -object_unfilled <ACTION action:! actor:NounPhrase->IS.object action_type:Verb object:"unknown">
            # a dog bites
            # a dog bit
            # !a dog bite
        NounPhrase[singular] Verb[MainVerb,simple,Transitive] -singular -transitive -object_unfilled <ACTION action:! actor:NounPhrase->IS.object action_type:Verb object:"unknown">
            # did <a dog bite> another dog
        NounPhrase[singular] Verb[MainVerb,simple,Intransitive] -singular -transitive -object_unfilled <ACTION action:! actor:NounPhrase->IS.object action_type:Verb>
            # did <a dog jump>
        NounPhrase[singular] Verb[MainVerb,!simple,Transitive] -singular -intransitive <IS object:! object_count:"1" noun_class:Noun | ACTION action:!! actor:! action_type:Verb>
            # dog bites

        VerbPhrase[ditransitive,indirect_object_unfilled] NounPhrase -ditransitive -actor_unfilled <VerbPhrase->ACTION.indirect_object=NounPhrase->IS.object>
            # give a horse some food
            # gave a horse some food

        NounPhrase VerbPhrase[ditransitive,actor_unfilled] -ditransitive -complete <VerbPhrase->ACTION.actor=NounPhrase->IS.object>
            # a man give a horse an apple

        Verb[Ditransitive] NounPhrase -ditransitive -indirect_object_unfilled -actor_unfilled <ACTION action:!! actor:"unknown" action_type:Verb object:NounPhrase->IS.object indirect_object:"unknown">
            # <give a horse> some food

        #Verb[Ditransitive] -ditransitive -actor_unfilled -indirect_object_unfilled -object_unfilled <ACTION

        #Noun[Pronoun,singular,GENDER,3rdPerson] Verb[3PPresent] -GENDER
        # he runs
        # she runs

        #VerbPhrase Conjunction VerbPhrase -plural
        # eats grass and drinks water
        # eating grass and drinking water

        Verb[continuous,Intransitive] PrepPhrase -continuous -actor_unfilled <ACTION action:! actor:"unknown" action_type:Verb>
            # running in the field
    AuxiliaryPhrase "AxP"
        Verb[ContinuousAuxiliaryVerb] Verb[MainVerb,simple] <TENSE action:Verb->ACTION.action time:present completeness:continuous>
            # !i <have run>
                # present complete
            # i <do run>
                # present continuous
        Verb[PerfectAuxiliaryVerb] Verb[MainVerb,pastPart] <TENSE action:Verb#2->ACTION.action time:present completeness:complete>
            # the dog <has given>
                # past complete
        Verb[PerfectAuxiliaryVerb] Verb[MainVerb,perfect] <TENSE action:Verb#2->ACTION.action time:present completeness:complete>
            # the dogs <have ran>
                # past complete

        Verb[PerfectAuxiliaryVerb] Verb[ContinuousAuxiliaryVerb] -complete <TENSE action:"unknown" time:present completeness:complete>
